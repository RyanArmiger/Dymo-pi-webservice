[Unit]
Description=Label printing service (Flask + waitress, DYMO LabelWriter 450)
After=network.target cups.service
Wants=network.target cups.service

[Service]
Type=simple
User=labelsvc
Group=labelsvc

WorkingDirectory=@@INSTALL_DIR@@
EnvironmentFile=@@INSTALL_DIR@@/.env

ExecStart=@@INSTALL_DIR@@/.venv/bin/python @@INSTALL_DIR@@/serve.py

Restart=on-failure
RestartSec=5

# Modest hardening; adjust if the app needs to write elsewhere.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

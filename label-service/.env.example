# label-service environment configuration
#
# Copy this file to `.env` in the same directory (install.sh does this for you
# automatically on first install) and adjust values as needed. Every variable
# here is read by config.py; anything left unset falls back to the default
# baked into config.py (shown below for reference).
#
# This file is loaded into the systemd service via EnvironmentFile= in
# label-service.service, so keep it as simple KEY=VALUE lines (no quoting,
# no export, no comments on the same line as a value).

# ---------------------------------------------------------------------------
# Printer / CUPS
# ---------------------------------------------------------------------------

# The CUPS queue name for the DYMO LabelWriter 450 (as shown by `lpstat -p`).
PRINTER_NAME=DYMO_LabelWriter_450

# CUPS custom page used for the two-up print page. The named w72h72 media has
# a smaller declared ImageableArea and causes approximately 90% scaling.
PAGE_SIZE=Custom.72x72

# ---------------------------------------------------------------------------
# Physical layout (all *_PX values are pixels at LABEL_DPI)
#
# These are NOMINAL STARTING VALUES ONLY. They must be confirmed with a
# physical calibration print (see the admin panel's calibration button, or
# `python print_labels.py --calibration --preview`) before trusting label
# alignment on real DYMO 450 + w72h72 (25mm x 13mm, two-up) stock. See
# README.md "Calibration" section.
# ---------------------------------------------------------------------------

# Rendering resolution used to rasterise labels before printing.
LABEL_DPI=300

# Nominal label size in millimetres (used to derive the *_PX values below if
# they are not set explicitly).
LABEL_WIDTH_MM=25.0
LABEL_HEIGHT_MM=13.0

# Individual sticker canvas size in pixels. Leave unset to derive from
# LABEL_WIDTH_MM/LABEL_HEIGHT_MM/LABEL_DPI; set explicitly after calibration
# if the derived value doesn't match the physical print.
#INDIVIDUAL_LABEL_WIDTH_PX=
#INDIVIDUAL_LABEL_HEIGHT_PX=

# Gap and margins used when compositing the two-up print page, in pixels.
#PAIR_GAP_PX=
#PAIR_MARGIN_X_PX=
#PAIR_MARGIN_Y_PX=

# Rotation (degrees) applied to the output page before sending to the
# printer. 90 was confirmed empirically on the Mac test queue; re-confirm on
# the Pi + DYMO 450 during calibration.
OUTPUT_ROTATION_DEGREES=90

# Calibrated translation for the current DYMO 450 and two-up stock. Negative
# values move the raster toward sticker A and the leading/left edge.
STICKER_ORIGIN_X_MM=-1.0
STICKER_ORIGIN_Y_MM=-2.0

# ---------------------------------------------------------------------------
# Label content layout (rarely need changing; see config.py for defaults)
# ---------------------------------------------------------------------------
#QR_QUIET_ZONE_MODULES=4
#LABEL_PADDING_PX=
#TEXT_COLUMN_GAP_PX=
#TEXT_TRAILING_MARGIN_PX=
#QR_SIZE_REDUCTION_PX=
#QR_LEADING_INSET_PX=
#LABEL_B_CONTENT_SHIFT_X_PX=
#ID_FONT_MAX_SIZE_PX=28
#ID_FONT_MIN_SIZE_PX=14
#SAMPLE_FONT_MAX_SIZE_PX=28
#SAMPLE_FONT_MIN_SIZE_PX=14
#TEXT_FONT_MAX_SIZE_PX=16
#TEXT_FONT_MIN_SIZE_PX=9
#LINE_SPACING_PX=1
#GROUP_SPACING_PX=4

# ---------------------------------------------------------------------------
# Field length limits
# ---------------------------------------------------------------------------
#MAX_SAMPLE_ID_LENGTH=16
#MAX_EXPERIMENT_ID_LENGTH=16
#MAX_REQUESTOR_ID_LENGTH=12

# ---------------------------------------------------------------------------
# ID / counter behaviour
# ---------------------------------------------------------------------------

# Number of digits in the zero-padded label ID (4 -> IDs 0001-9999). Changing
# this after labels have already been printed will change the ID format for
# new labels but not renumber existing ones.
LABEL_ID_DIGITS=4

# ---------------------------------------------------------------------------
# Batch / upload limits
# ---------------------------------------------------------------------------

# Maximum copies allowed for a single row in a batch spreadsheet.
MAX_COPIES_PER_ROW=100

# Maximum total labels allowed in a single batch/print run.
MAX_BATCH_LABELS=1000

# Maximum number of data rows accepted from an uploaded spreadsheet.
MAX_SPREADSHEET_ROWS=1000

# Maximum accepted upload size, in bytes (default 5 MiB).
MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# Storage locations
#
# On the Pi these point at /var/lib/label-service so the database and
# generated files survive reinstalls/upgrades of the code in /opt. install.sh
# creates this directory and sets ownership for you.
# ---------------------------------------------------------------------------

# Optional: overrides the default location instance/ is derived from
# (BASE_DIR/instance). Not usually needed if DATABASE_PATH is set directly.
#INSTANCE_DIR=/var/lib/label-service

# Path to the SQLite database file.
DATABASE_PATH=/var/lib/label-service/labels.db

# Directory used for generated preview/print images.
GENERATED_DIR=/var/lib/label-service/generated

# Permanent archive for confirmed Excel batch source files.
BATCH_UPLOAD_DIR=/var/lib/label-service/batch_uploads

# How long generated files are kept before being cleaned up, in hours.
GENERATED_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# Web / auth
# ---------------------------------------------------------------------------

# Interface/port waitress binds to.
HOST=0.0.0.0
PORT=8000

# Keep memory use modest on the original single-core, 512 MB Pi Zero.
WAITRESS_THREADS=2

# Flask session signing key. MUST be set to a long random value in
# production — never use the config.py default outside development.
# install.sh generates and fills this in automatically for you on first
# install. To generate one manually:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Shared password hash for the entire application. This MUST be a werkzeug
# generate_password_hash(...) output, NOT a plaintext password. Generate one
# with:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-chosen-password'))"
# With AUTH_REQUIRED=1, leaving this blank locks the application until a hash
# is configured.
ADMIN_PASSWORD_HASH=

# Require login for every application route.
AUTH_REQUIRED=1

# Sessions expire after this many hours.
SESSION_LIFETIME_HOURS=8

# Set to 1 only when the service is accessed over HTTPS. Secure cookies are
# intentionally disabled for the current HTTP-only LAN deployment.
SESSION_COOKIE_SECURE=0

# Per-IP temporary lockout after repeated incorrect passwords.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Batch failure policy
# ---------------------------------------------------------------------------

# If "1" (default), a batch print run stops at the first failed label. Set to
# "0" to continue printing remaining labels after a failure.
STOP_ON_FIRST_BATCH_FAILURE=1
